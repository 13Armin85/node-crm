PORT=5001
DB_URL=mongodb://127.0.0.1:27017
DB=Prolink
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000

# Used only when the database has no super administrator.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator
INITIAL_ADMIN_PHONE=
DEFAULT_USERS=

# Optional email sender settings. Task recipients are read automatically from the assigned user's email.
EMAIL_SENDER=
EMAIL_SENDER_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_FROM=
