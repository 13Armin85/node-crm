PORT=5001
DB_URL=mongodb://127.0.0.1:27017
DB=Prolink
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000

# Used only when the database has no active developer. Provisioned by the server operator.
INITIAL_DEVELOPER_EMAIL=
INITIAL_DEVELOPER_PASSWORD=
INITIAL_DEVELOPER_FIRST_NAME=System
INITIAL_DEVELOPER_LAST_NAME=Developer

# Used only when the database has no administrator.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator
INITIAL_ADMIN_PHONE=
DEFAULT_USERS=

# Optional email sender settings. Task recipients are read automatically from the assigned user's email.
EMAIL_SENDER=your-email@gmail.com
EMAIL_SENDER_PASSWORD=your-gmail-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_FROM=your-email@gmail.com
